# Required: generate a long random secret and keep it server-side only.
ASR_API_KEY=replace-with-a-long-random-secret

# Optional Hugging Face read token if model access requires accepting repository terms.
HF_TOKEN=

# AI4Bharat multilingual model
AI4BHARAT_MODEL_ID=ai4bharat/indic-conformer-600m-multilingual

# OpenAI is called only if AI4Bharat fails or returns an empty transcript.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

MAX_AUDIO_BYTES=26214400
LOG_LEVEL=INFO
